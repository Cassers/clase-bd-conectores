# Copia este archivo como .env y llena tus datos de Supabase:
# Supabase → Project Settings → Database → Connection string → "Session pooler"
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=tu-contraseña-de-la-base
DB_NAME=postgres
# Require    = conexión cifrada (TLS), sin verificar el certificado. Suficiente para la clase.
# VerifyFull = cifrada y verifica el certificado del servidor (producción). Necesita DB_ROOT_CERT.
# Disable    = texto plano: solo en Docker local.
DB_SSL=Require
# Certificado descargado de Supabase → Database → Settings → SSL Configuration
# DB_ROOT_CERT=prod-ca-2021.crt
